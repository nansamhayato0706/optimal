ZAITAKU_DB_HOST=localhost
ZAITAKU_DB_NAME=jigyodan_zk_honbu
ZAITAKU_DB_USER=root
ZAITAKU_DB_PASS=
ZAITAKU_APP_URL=http://localhost/zaitakukanri_honbu_new
ZAITAKU_SV_ROOT=C:/xampp/htdocs/zaitakukanri_honbu_new/
ZAITAKU_GROUP_LABEL=事業団
ZAITAKU_MAX_USER=80
ZAITAKU_STATUS_SUMMARY_REBUILD_ENABLED=1
# OpenAI 音声文字起こし（WPF 音声入力）— 未設定なら WPF は SAPI フォールバック
ZAITAKU_OPENAI_API_KEY=
ZAITAKU_OPENAI_TRANSCRIBE_MODEL=gpt-transcribe
# 1人あたりの1日の累計音声秒数の上限（コスト管理ではなく暴走防止のため）
ZAITAKU_TRANSCRIBE_DAILY_SECONDS=3600

# 外部DB(jigyodan_kouzono)を別ユーザー/別ホストで参照する場合のみ設定（祝日取得用・SELECTのみ）
# ZAITAKU_EXT_DB_NAME=jigyodan_kouzono
# ZAITAKU_EXT_DB_HOST=
# ZAITAKU_EXT_DB_USER=
# ZAITAKU_EXT_DB_PASS=
